# Copy these settings to /home/al/.config/tractor-voice-notes/voice-note.env.
# This example contains no credentials or secrets.
VOICE_NOTE_BIND_HOST=192.168.193.217
VOICE_NOTE_PORT=8443
VOICE_NOTE_LOG_DIR=/home/al/field_logs/voice_note_poc
VOICE_NOTE_TLS_CERT=/home/al/.config/tractor-voice-notes/tls/server.crt
VOICE_NOTE_TLS_KEY=/home/al/.config/tractor-voice-notes/tls/server.key
GOOGLE_APPLICATION_CREDENTIALS=/home/al/.config/tractor-voice-notes/google-service-account.json
VOICE_NOTE_LANGUAGE=en-US
VOICE_NOTE_MODEL=command_and_search
VOICE_NOTE_SAMPLE_RATE=48000
VOICE_NOTE_MAX_STREAM_SECONDS=270
# End each Google stream at a speech pause, then reopen it automatically.
VOICE_NOTE_SINGLE_UTTERANCE=1
# Set to 1 only for a local plumbing test that must not call Google.
VOICE_NOTE_FAKE_TRANSCRIPTS=0
