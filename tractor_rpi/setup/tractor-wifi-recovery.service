[Unit]
Description=Tractor01 Manual Recovery Control (onboard router only)
Documentation=https://github.com/jones2126/tractor2025
After=network-online.target teensy-bridge.service
Wants=network-online.target teensy-bridge.service
Conflicts=tractor-wifi-control.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=al
WorkingDirectory=/home/al/tractor2025
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=tractor-phone-control
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/test -r /home/al/.config/tractor-wifi-control/tls/server.crt
ExecStartPre=/usr/bin/test -r /home/al/.config/tractor-wifi-control/tls/server.key
ExecStartPre=/usr/sbin/ip -4 address show dev eth0 to 192.168.8.20/32
ExecStart=/usr/bin/python3 -u /home/al/tractor2025/tractor_rpi/testing/webrtc/wifi_primary_control_20261022.py --host 192.168.8.20 --tls-cert /home/al/.config/tractor-wifi-control/tls/server.crt --tls-key /home/al/.config/tractor-wifi-control/tls/server.key --operator-key-file /home/al/.config/tractor-wifi-control/operator.key --authority-policy onboard-router-recovery --ownership-lock /run/tractor-phone-control/ownership.lock --log-dir /home/al/field_logs/manual_recovery
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tractor-wifi-recovery

[Install]
# Deliberately has no boot target: recovery must never start automatically.
