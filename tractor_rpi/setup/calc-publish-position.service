[Unit]
Description=Tractor01 position publishing and sensor acquisition
Wants=network-online.target tractor-telemetry-recorder.service
After=network-online.target tractor-telemetry-recorder.service

[Service]
Type=simple
User=al
WorkingDirectory=/home/al/tractor2025
RuntimeDirectory=tractor-position
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/bin/python3 -u /home/al/tractor2025/tractor_rpi/testing/configure_dual_f9p_5hz_profile_20260923.py --heading-startup --device-wait-seconds 30
ExecStart=/usr/bin/python3 -u -m tractor_rpi.calc_publish_position
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=calc-publish-position

[Install]
WantedBy=multi-user.target
Alias=rtcm-server.service
