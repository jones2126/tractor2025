[Unit]
Description=Tractor01 Wi-Fi Handheld Control
Documentation=https://github.com/jones2126/tractor2025
After=network-online.target zerotier-one.service teensy-bridge.service
Wants=network-online.target zerotier-one.service teensy-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=al
WorkingDirectory=/home/al/tractor2025
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -r /home/al/.config/tractor-wifi-control/tls/server.crt
ExecStartPre=/usr/bin/test -r /home/al/.config/tractor-wifi-control/tls/server.key
ExecStart=/usr/bin/python3 -u /home/al/tractor2025/tractor_rpi/testing/webrtc/wifi_primary_control_20261003.py --tls-cert /home/al/.config/tractor-wifi-control/tls/server.crt --tls-key /home/al/.config/tractor-wifi-control/tls/server.key
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tractor-wifi-control

[Install]
WantedBy=multi-user.target
