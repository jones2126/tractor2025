# Normalize text files to Unix/Linux LF line endings
* text=auto eol=lf

# Windows command files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.zip binary

