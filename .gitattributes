# Normalize text files to Unix/Linux LF line endings
* text=auto eol=lf

# Windows command files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.zip binary

# Preserve archived Git patch files exactly
*.patch -text

# Preserve the checksum-archived September 18/23 field runs byte-for-byte so
# recorded SHA-256 manifests and replay provenance remain valid across systems.
field_testing/sites/**/runs/20260918_*/** -text -eol
field_testing/sites/**/runs/20260923_*/** -text -eol
